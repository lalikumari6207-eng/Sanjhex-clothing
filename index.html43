<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SANJHEX — Unisex Streetwear</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0a0a;
    --surface: #141414;
    --surface2: #1e1e1e;
    --border: #2a2a2a;
    --accent: #c8f135;
    --accent2: #ff4d4d;
    --text: #f0f0f0;
    --muted: #888;
    --white: #ffffff;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
    cursor: none;
  }

  /* Custom Cursor */
  .cursor {
    width: 12px; height: 12px;
    background: var(--accent);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 99999;
    transition: transform 0.1s ease;
    mix-blend-mode: difference;
  }
  .cursor-ring {
    width: 36px; height: 36px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 99998;
    transition: all 0.15s ease;
    mix-blend-mode: difference;
  }

  /* PAGES */
  .page { display: none; min-height: 100vh; }
  .page.active { display: block; }

  /* ============ NAVBAR ============ */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 40px;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    letter-spacing: 4px;
    color: var(--accent);
    cursor: pointer;
  }
  .nav-links {
    display: flex; gap: 32px; list-style: none;
  }
  .nav-links a {
    color: var(--muted); text-decoration: none;
    font-size: 0.8rem; letter-spacing: 2px; text-transform: uppercase;
    transition: color 0.2s;
    cursor: pointer;
  }
  .nav-links a:hover { color: var(--accent); }
  .nav-right {
    display: flex; align-items: center; gap: 20px;
  }
  .cart-btn {
    background: var(--accent);
    color: #000;
    border: none;
    padding: 10px 20px;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    cursor: pointer;
    position: relative;
    transition: all 0.2s;
  }
  .cart-btn:hover { background: #b5da20; }
  .cart-count {
    background: var(--accent2);
    color: #fff;
    border-radius: 50%;
    width: 20px; height: 20px;
    font-size: 0.65rem;
    display: inline-flex;
    align-items: center; justify-content: center;
    margin-left: 6px;
    font-weight: 700;
  }

  /* ============ HERO ============ */
  .hero {
    min-height: 100vh;
    display: flex; align-items: center;
    padding: 120px 40px 60px;
    position: relative;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(200,241,53,0.06) 0%, transparent 60%),
                radial-gradient(ellipse at 20% 80%, rgba(255,77,77,0.05) 0%, transparent 50%);
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(var(--border) 1px, transparent 1px),
                      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.3;
  }
  .hero-content { position: relative; z-index: 2; max-width: 700px; }
  .hero-tag {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem; letter-spacing: 3px;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 20px;
    display: flex; align-items: center; gap: 10px;
  }
  .hero-tag::before {
    content: '';
    width: 30px; height: 1px;
    background: var(--accent);
  }
  .hero h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4rem, 10vw, 9rem);
    line-height: 0.9;
    letter-spacing: 2px;
    margin-bottom: 30px;
  }
  .hero h1 span { color: var(--accent); }
  .hero p {
    font-size: 1rem; color: var(--muted);
    line-height: 1.7; max-width: 420px;
    margin-bottom: 40px;
  }
  .hero-btns { display: flex; gap: 16px; flex-wrap: wrap; }
  .btn-primary {
    background: var(--accent); color: #000;
    padding: 16px 36px;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 1px;
    border: none; cursor: pointer;
    transition: all 0.25s;
    text-transform: uppercase;
  }
  .btn-primary:hover { background: #b5da20; transform: translateY(-2px); }
  .btn-outline {
    background: transparent; color: var(--text);
    padding: 16px 36px;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 1px;
    border: 1px solid var(--border); cursor: pointer;
    transition: all 0.25s;
    text-transform: uppercase;
  }
  .btn-outline:hover { border-color: var(--accent); color: var(--accent); }

  .hero-marquee {
    position: absolute; bottom: 0; left: 0; right: 0;
    overflow: hidden;
    border-top: 1px solid var(--border);
    padding: 14px 0;
    background: var(--surface);
  }
  .marquee-track {
    display: flex; gap: 0;
    animation: marquee 18s linear infinite;
    white-space: nowrap;
  }
  .marquee-item {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem; letter-spacing: 4px;
    color: var(--muted); padding: 0 30px;
  }
  .marquee-item span { color: var(--accent); margin-right: 30px; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ============ SECTION HEADER ============ */
  .section-header {
    padding: 80px 40px 40px;
    display: flex; align-items: flex-end; justify-content: space-between;
    flex-wrap: wrap; gap: 20px;
  }
  .section-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem; letter-spacing: 3px;
    color: var(--accent); text-transform: uppercase;
    margin-bottom: 10px;
  }
  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: 2px;
    line-height: 1;
  }
  .view-all {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem; letter-spacing: 2px;
    color: var(--muted); text-transform: uppercase;
    background: none; border: 1px solid var(--border);
    padding: 10px 20px; cursor: pointer;
    transition: all 0.2s;
  }
  .view-all:hover { border-color: var(--accent); color: var(--accent); }

  /* ============ PRODUCT GRID ============ */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2px;
    padding: 0 40px;
  }
  .product-card {
    background: var(--surface);
    position: relative; overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s;
  }
  .product-card:hover { transform: scale(1.01); z-index: 2; }
  .product-img {
    width: 100%; aspect-ratio: 3/4;
    object-fit: cover;
    background: var(--surface2);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    position: relative;
  }
  .product-img-placeholder {
    width: 100%; aspect-ratio: 3/4;
    background: var(--surface2);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.2rem; letter-spacing: 3px;
    color: var(--border);
    position: relative;
    overflow: hidden;
  }
  .product-img-placeholder img {
    width: 100%; height: 100%;
    object-fit: cover;
    position: absolute; inset: 0;
  }
  .product-badge {
    position: absolute; top: 14px; left: 14px;
    background: var(--accent); color: #000;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 1px;
    padding: 4px 10px; text-transform: uppercase;
    z-index: 2;
  }
  .product-badge.sale { background: var(--accent2); color: #fff; }
  .product-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.7);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.3s;
    gap: 10px; flex-direction: column;
  }
  .product-card:hover .product-overlay { opacity: 1; }
  .overlay-btn {
    background: var(--accent); color: #000;
    border: none; padding: 12px 28px;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 1px; cursor: pointer;
    width: 180px; transition: all 0.2s;
  }
  .overlay-btn:hover { background: #b5da20; }
  .overlay-btn.outline {
    background: transparent; color: #fff;
    border: 1px solid rgba(255,255,255,0.4);
  }
  .overlay-btn.outline:hover { border-color: var(--accent); color: var(--accent); }
  .product-info {
    padding: 16px;
    border-top: 1px solid var(--border);
  }
  .product-name {
    font-size: 0.9rem; font-weight: 500;
    letter-spacing: 0.5px; margin-bottom: 6px;
  }
  .product-meta {
    display: flex; align-items: center; justify-content: space-between;
  }
  .product-price {
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem; color: var(--accent); font-weight: 700;
  }
  .product-price .original {
    color: var(--muted); text-decoration: line-through;
    font-size: 0.75rem; margin-right: 8px;
  }
  .product-sizes {
    font-size: 0.65rem; color: var(--muted);
    letter-spacing: 1px; text-transform: uppercase;
    font-family: 'Space Mono', monospace;
  }

  /* ============ CART SIDEBAR ============ */
  .cart-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 2000;
    display: none;
    backdrop-filter: blur(4px);
  }
  .cart-overlay.open { display: block; }
  .cart-sidebar {
    position: fixed; top: 0; right: -480px;
    width: 440px; max-width: 95vw;
    height: 100vh;
    background: var(--surface);
    border-left: 1px solid var(--border);
    z-index: 2001;
    transition: right 0.35s cubic-bezier(0.4,0,0.2,1);
    display: flex; flex-direction: column;
  }
  .cart-sidebar.open { right: 0; }
  .cart-header {
    padding: 24px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
  }
  .cart-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem; letter-spacing: 2px;
  }
  .close-cart {
    background: none; border: none; color: var(--muted);
    font-size: 1.5rem; cursor: pointer;
    transition: color 0.2s;
    width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
  }
  .close-cart:hover { color: var(--accent2); }
  .cart-items { flex: 1; overflow-y: auto; padding: 20px; }
  .cart-empty {
    text-align: center; padding: 60px 20px;
    color: var(--muted);
    font-family: 'Space Mono', monospace; font-size: 0.8rem;
    letter-spacing: 2px;
  }
  .cart-item {
    display: flex; gap: 14px;
    padding: 16px 0; border-bottom: 1px solid var(--border);
    position: relative;
  }
  .cart-item-img {
    width: 80px; height: 100px;
    background: var(--surface2);
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .cart-item-img img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .cart-item-details { flex: 1; }
  .cart-item-name {
    font-size: 0.85rem; font-weight: 500; margin-bottom: 4px;
  }
  .cart-item-size {
    font-size: 0.7rem; color: var(--muted);
    font-family: 'Space Mono', monospace; letter-spacing: 1px;
    text-transform: uppercase; margin-bottom: 10px;
  }
  .cart-item-qty {
    display: flex; align-items: center; gap: 10px;
  }
  .qty-btn {
    width: 26px; height: 26px;
    background: var(--surface2); border: 1px solid var(--border);
    color: var(--text); cursor: pointer;
    font-size: 1rem; display: flex; align-items: center; justify-content: center;
    transition: all 0.2s;
  }
  .qty-btn:hover { border-color: var(--accent); color: var(--accent); }
  .qty-num {
    font-family: 'Space Mono', monospace; font-size: 0.8rem; min-width: 20px;
    text-align: center;
  }
  .cart-item-price {
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem; color: var(--accent);
    font-weight: 700;
    align-self: flex-start;
    white-space: nowrap;
  }
  .remove-item {
    position: absolute; top: 16px; right: 0;
    background: none; border: none;
    color: var(--muted); cursor: pointer; font-size: 1rem;
    transition: color 0.2s;
  }
  .remove-item:hover { color: var(--accent2); }
  .cart-footer {
    padding: 24px; border-top: 1px solid var(--border);
  }
  .cart-subtotal {
    display: flex; justify-content: space-between;
    align-items: center; margin-bottom: 8px;
  }
  .cart-subtotal span:first-child {
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
    letter-spacing: 2px; text-transform: uppercase; color: var(--muted);
  }
  .cart-subtotal span:last-child {
    font-family: 'Space Mono', monospace; font-size: 1rem;
    color: var(--accent); font-weight: 700;
  }
  .cart-note {
    font-size: 0.7rem; color: var(--muted); margin-bottom: 20px;
    text-align: center;
  }
  .checkout-btn {
    width: 100%; background: var(--accent); color: #000;
    border: none; padding: 16px;
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem; font-weight: 700;
    letter-spacing: 2px; cursor: pointer;
    text-transform: uppercase;
    transition: all 0.25s;
  }
  .checkout-btn:hover { background: #b5da20; }

  /* ============ CHECKOUT MODAL ============ */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 3000;
    display: none;
    align-items: center; justify-content: center;
    backdrop-filter: blur(8px);
    padding: 20px;
  }
  .modal-overlay.open { display: flex; }
  .modal {
    background: var(--surface);
    border: 1px solid var(--border);
    width: 100%; max-width: 520px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }
  .modal-header {
    padding: 24px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    position: sticky; top: 0; background: var(--surface); z-index: 1;
  }
  .modal-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.6rem; letter-spacing: 2px;
  }
  .close-modal {
    background: none; border: none; color: var(--muted);
    font-size: 1.4rem; cursor: pointer; transition: color 0.2s;
  }
  .close-modal:hover { color: var(--accent2); }
  .modal-body { padding: 28px; }
  .form-group { margin-bottom: 18px; }
  .form-label {
    display: block; font-size: 0.7rem;
    font-family: 'Space Mono', monospace;
    letter-spacing: 2px; text-transform: uppercase;
    color: var(--muted); margin-bottom: 8px;
  }
  .form-input, .form-select {
    width: 100%; background: var(--surface2);
    border: 1px solid var(--border); color: var(--text);
    padding: 12px 14px; font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    transition: border-color 0.2s;
    outline: none;
    -webkit-appearance: none;
  }
  .form-input:focus, .form-select:focus { border-color: var(--accent); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .order-summary {
    background: var(--surface2); border: 1px solid var(--border);
    padding: 18px; margin-bottom: 22px;
  }
  .order-summary-title {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem; letter-spacing: 2px;
    text-transform: uppercase; color: var(--muted);
    margin-bottom: 12px;
  }
  .order-row {
    display: flex; justify-content: space-between;
    font-size: 0.85rem; margin-bottom: 6px;
  }
  .order-row.total {
    border-top: 1px solid var(--border); margin-top: 10px;
    padding-top: 10px; font-weight: 700;
    font-family: 'Space Mono', monospace;
    color: var(--accent);
  }
  .upi-box {
    background: linear-gradient(135deg, #1a2f00, #0f1f00);
    border: 1px solid var(--accent);
    padding: 20px;
    margin-bottom: 20px;
    text-align: center;
  }
  .upi-title {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem; letter-spacing: 3px;
    text-transform: uppercase; color: var(--accent);
    margin-bottom: 8px;
  }
  .upi-id {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem; letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .upi-note {
    font-size: 0.72rem; color: var(--muted);
    line-height: 1.5;
  }
  .pay-btn {
    width: 100%; background: var(--accent); color: #000;
    border: none; padding: 18px;
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem; font-weight: 700;
    letter-spacing: 2px; cursor: pointer;
    text-transform: uppercase;
    transition: all 0.25s;
    display: flex; align-items: center; justify-content: center; gap: 10px;
  }
  .pay-btn:hover { background: #b5da20; transform: translateY(-1px); }
  .pay-btn:active { transform: translateY(0); }

  /* ============ SUCCESS MODAL ============ */
  .success-modal {
    text-align: center; padding: 60px 40px;
  }
  .success-icon {
    width: 80px; height: 80px;
    background: var(--accent);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 24px;
    font-size: 2rem;
    color: #000;
  }
  .success-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.4rem; letter-spacing: 2px;
    margin-bottom: 12px;
  }
  .success-msg {
    color: var(--muted); font-size: 0.9rem;
    line-height: 1.7; margin-bottom: 30px;
    max-width: 340px; margin-left: auto; margin-right: auto;
  }
  .order-id {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem; letter-spacing: 2px;
    color: var(--accent); margin-bottom: 30px;
  }

  /* ============ PRODUCT DETAIL MODAL ============ */
  .product-modal-body {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  @media (max-width: 640px) {
    .product-modal-body { grid-template-columns: 1fr; }
  }
  .product-modal-img {
    aspect-ratio: 3/4; background: var(--surface2);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .product-modal-img img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .product-modal-info { padding: 32px; }
  .product-modal-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem; letter-spacing: 2px;
    margin-bottom: 8px;
  }
  .product-modal-price {
    font-family: 'Space Mono', monospace;
    font-size: 1.2rem; color: var(--accent);
    font-weight: 700; margin-bottom: 20px;
  }
  .product-modal-desc {
    font-size: 0.85rem; color: var(--muted);
    line-height: 1.7; margin-bottom: 24px;
  }
  .size-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem; letter-spacing: 2px;
    text-transform: uppercase; color: var(--muted);
    margin-bottom: 10px;
  }
  .size-options {
    display: flex; gap: 8px; flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .size-opt {
    width: 42px; height: 42px;
    background: var(--surface2); border: 1px solid var(--border);
    color: var(--text); cursor: pointer;
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
    font-weight: 700; transition: all 0.2s;
    display: flex; align-items: center; justify-content: center;
  }
  .size-opt:hover { border-color: var(--accent); color: var(--accent); }
  .size-opt.selected {
    background: var(--accent); color: #000;
    border-color: var(--accent);
  }
  .add-to-cart-main {
    width: 100%; background: var(--accent); color: #000;
    border: none; padding: 14px;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 1px; cursor: pointer;
    text-transform: uppercase;
    transition: all 0.25s;
    margin-bottom: 10px;
  }
  .add-to-cart-main:hover { background: #b5da20; }
  .buy-now-main {
    width: 100%; background: transparent; color: var(--text);
    border: none; padding: 14px;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 1px; cursor: pointer;
    text-transform: uppercase;
    transition: all 0.25s;
    margin-bottom: 10px;
  }
  .add-to-cart-main:hover { background: #b5da20; }
  .buy-now-main {
    width: 100%; background: transparent; color: var(--text);
    border: 1px solid var(--border); padding: 14px;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 1px; cursor: pointer;
    text-transform: uppercase;
    transition: all 0.25s;
  }
  .buy-now-main:hover { border-color: var(--accent); color: var(--accent); }

  /* ============ FILTER BAR ============ */
  .filter-bar {
    padding: 0 40px 24px;
    display: flex; gap: 10px; flex-wrap: wrap;
    align-items: center;
  }
  .filter-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem; letter-spacing: 2px;
    text-transform: uppercase; color: var(--muted);
    margin-right: 6px;
  }
  .filter-btn {
    background: none; border: 1px solid var(--border);
    color: var(--muted); padding: 7px 16px;
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 1px; text-transform: uppercase;
    cursor: pointer; transition: all 0.2s;
  }
  .filter-btn:hover, .filter-btn.active {
    border-color: var(--accent); color: var(--accent);
  }

  /* ============ ABOUT / STRIP ============ */
  .brand-strip {
    margin: 60px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 40px 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
  }
  .strip-item { text-align: center; }
  .strip-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3rem; letter-spacing: 2px;
    color: var(--accent);
  }
  .strip-text {
    font-size: 0.75rem; color: var(--muted);
    letter-spacing: 2px; text-transform: uppercase;
    font-family: 'Space Mono', monospace;
  }

  /* ============ FOOTER ============ */
  footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 50px 40px 30px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px; margin-bottom: 40px;
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
  .footer-brand {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.5rem; letter-spacing: 4px;
    color: var(--accent); margin-bottom: 14px;
  }
  .footer-desc {
    font-size: 0.82rem; color: var(--muted);
    line-height: 1.7; max-width: 280px;
  }
  .footer-heading {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem; letter-spacing: 3px;
    text-transform: uppercase; color: var(--text);
    margin-bottom: 16px;
  }
  .footer-links { list-style: none; }
  .footer-links li { margin-bottom: 10px; }
  .footer-links a {
    color: var(--muted); text-decoration: none;
    font-size: 0.82rem; transition: color 0.2s;
    cursor: pointer;
  }
  .footer-links a:hover { color: var(--accent); }
  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-top: 24px;
    display: flex; justify-content: space-between;
    align-items: center; flex-wrap: wrap; gap: 10px;
  }
  .footer-copy {
    font-size: 0.72rem; color: var(--muted);
    font-family: 'Space Mono', monospace;
  }

  /* ============ TOAST ============ */
  .toast {
    position: fixed; bottom: 30px; left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: var(--accent); color: #000;
    padding: 14px 28px;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem; font-weight: 700; letter-spacing: 1px;
    z-index: 9999;
    transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
    pointer-events: none;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }
    /* ============ ADMIN PANEL ============ */
  .admin-page {
    min-height: 100vh;
    background: #080808;
  }
  .admin-nav {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 16px 30px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .admin-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem; letter-spacing: 3px;
  }
  .admin-logo span { color: var(--accent); }
  .admin-logout {
    background: none; border: 1px solid var(--border);
    color: var(--muted); padding: 8px 16px;
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 1px; cursor: pointer;
    transition: all 0.2s;
  }
  .admin-logout:hover { border-color: var(--accent2); color: var(--accent2); }
  .admin-layout {
    display: grid; grid-template-columns: 220px 1fr;
    min-height: calc(100vh - 61px);
  }
  @media (max-width: 768px) {
    .admin-layout { grid-template-columns: 1fr; }
    .admin-sidebar { display: none; }
  }
  .admin-sidebar {
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 20px 0;
  }
  .admin-menu-item {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 20px; cursor: pointer;
    font-size: 0.8rem; color: var(--muted);
    letter-spacing: 0.5px;
    transition: all 0.2s;
    border-left: 2px solid transparent;
  }
  .admin-menu-item:hover { color: var(--text); background: rgba(255,255,255,0.03); }
  .admin-menu-item.active {
    color: var(--accent); border-left-color: var(--accent);
    background: rgba(200,241,53,0.05);
  }
  .admin-menu-icon { font-size: 1rem; }
  .admin-content { padding: 30px; }
  .admin-section { display: none; }
  .admin-section.active { display: block; }
  .admin-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem; letter-spacing: 2px;
    margin-bottom: 6px;
  }
  .admin-subtitle {
    color: var(--muted); font-size: 0.82rem; margin-bottom: 28px;
  }
  .stats-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px; margin-bottom: 30px;
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 20px;
  }
  .stat-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem; letter-spacing: 2px;
    text-transform: uppercase; color: var(--muted);
    margin-bottom: 8px;
  }
  .stat-val {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.2rem; letter-spacing: 1px;
    color: var(--accent);
  }
  .stat-change {
    font-size: 0.7rem; color: var(--muted); margin-top: 4px;
  }

  /* Admin Form */
  .admin-form {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 28px;
    margin-bottom: 30px;
  }
  .admin-form-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem; letter-spacing: 2px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .admin-form-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 600px) {
    .admin-form-grid { grid-template-columns: 1fr; }
  }
  .admin-form-full { grid-column: 1 / -1; }
  .admin-form textarea {
    width: 100%; background: var(--surface2);
    border: 1px solid var(--border); color: var(--text);
    padding: 12px 14px; font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem; resize: vertical; min-height: 90px;
    outline: none; transition: border-color 0.2s;
  }
  .admin-form textarea:focus { border-color: var(--accent); }
  .admin-save {
    background: var(--accent); color: #000;
    border: none; padding: 12px 32px;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem; font-weight: 700;
    letter-spacing: 1px; cursor: pointer;
    transition: all 0.2s; margin-top: 10px;
    text-transform: uppercase;
  }
  .admin-save:hover { background: #b5da20; }
  .admin-cancel {
    background: transparent; color: var(--muted);
    border: 1px solid var(--border); padding: 12px 24px;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem; font-weight: 700;
    letter-spacing: 1px; cursor: pointer;
    transition: all 0.2s; margin-top: 10px; margin-left: 10px;
    text-transform: uppercase;
  }
  .admin-cancel:hover { border-color: var(--muted); color: var(--text); }
  * Products Table */
  .products-table {
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .table-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 20px; border-bottom: 1px solid var(--border);
  }
  .table-title {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem; letter-spacing: 2px;
    text-transform: uppercase;
  }
  .add-product-btn {
    background: var(--accent); color: #000;
    border: none; padding: 9px 20px;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem; font-weight: 700;
    letter-spacing: 1px; cursor: pointer;
    transition: all 0.2s; text-transform: uppercase;
  }
  .add-product-btn:hover { background: #b5da20; }
  .table-wrap { overflow-x: auto; }
  table {
    width: 100%; border-collapse: collapse;
  }
  thead tr {
    border-bottom: 1px solid var(--border);
    background: var(--surface2);
  }
  th, td {
    padding: 12px 16px; text-align: left;
    font-size: 0.78rem;
  }
  th {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem; letter-spacing: 2px;
    text-transform: uppercase; color: var(--muted);
    white-space: nowrap;
  }
  td { border-bottom: 1px solid rgba(42,42,42,0.5); }
  tr:last-child td { border-bottom: none; }
  .td-img {
    width: 44px; height: 54px;
    background: var(--surface2); object-fit: cover;
    display: block;
    overflow: hidden;
  }
  .td-img img { width: 100%; height: 100%; object-fit: cover; }
  .td-badge {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem; padding: 3px 8px;
    text-transform: uppercase; letter-spacing: 1px;
    display: inline-block;
  }
  .td-badge.active { background: rgba(200,241,53,0.15); color: var(--accent); }
  .td-badge.inactive { background: rgba(136,136,136,0.15); color: var(--muted); }
  .table-action {
    background: none; border: none; cursor: pointer;
    color: var(--muted); font-size: 0.75rem;
    font-family: 'Space Mono', monospace;
    padding: 5px 10px; transition: color 0.2s;
    text-decoration: underline;
  }
  .table-action:hover { color: var(--accent); }
  .table-action.del:hover { color: var(--accent2); }

  /* Orders */
  .order-row-item {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 16px 20px; margin-bottom: 8px;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
  }
  .order-info { flex: 1; min-width: 200px; }
  .order-num {
    font-family: 'Space Mono', monospace; font-size: 0.75rem;
    color: var(--accent); margin-bottom: 4px;
  }
  .order-customer { font-size: 0.85rem; margin-bottom: 2px; }
  .order-date { font-size: 0.72rem; color: var(--muted); }
  .order-amount {
    font-family: 'Space Mono', monospace;
    font-size: 1rem; color: var(--accent);
    font-weight: 700;
  }
  .order-status-select {
    background: var(--surface2);
    border: 1px solid var(--border); color: var(--text);
    padding: 6px 10px; font-family: 'Space Mono', monospace;
    font-size: 0.65rem; cursor: pointer;
    outline: none;
  }

  /* Settings */
  .settings-section {
    background: var(--surface); border: 1px solid var(--border);
    padding: 24px; margin-bottom: 20px;
  }
  .settings-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem; letter-spacing: 2px;
    margin-bottom: 18px; padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  /* Login */
  .login-page {
    min-height: 100vh; background: var(--bg);
    display: flex; align-items: center; justify-content: center;
    padding: 20px;
  }
  .login-box {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 40px; width: 100%; max-width: 380px;
  }
  .login-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.2rem; letter-spacing: 4px;
    color: var(--accent); margin-bottom: 6px;
  }
  .login-sub {
    font-size: 0.72rem; color: var(--muted);
    font-family: 'Space Mono', monospace;
    letter-spacing: 2px; text-transform: uppercase;
    margin-bottom: 30px;
  }
  .login-btn {
    width: 100%; background: var(--accent); color: #000;
    border: none; padding: 14px;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 2px; cursor: pointer;
    transition: all 0.25s; text-transform: uppercase;
    margin-top: 8px;
  }
  .login-btn:hover { background: #b5da20; }
  .login-err {
    color: var(--accent2); font-size: 0.75rem;
    margin-top: 8px; text-align: center;
    font-family: 'Space Mono', monospace;
    display: none;
  }
  .login-err.show { display: block; }

  /* Upload area */
  .img-upload-area {
    border: 2px dashed var(--border);
    padding: 24px; text-align: center;
    cursor: pointer; transition: border-color 0.2s;
    position: relative; overflow: hidden;
  }
  .img-upload-area:hover { border-color: var(--accent); }
  .img-upload-area input[type=file] {
    position: absolute; inset: 0; opacity: 0; cursor: pointer;
  }
  .img-upload-text {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem; letter-spacing: 2px;
    text-transform: uppercase; color: var(--muted);
  }
  .img-preview {
    max-height: 120px; max-width: 100%;
    object-fit: contain; margin-top: 10px;
    display: none;
  }

  /* Notification dot */
  .notif-dot {
    width: 8px; height: 8px;
    background: var(--accent2); border-radius: 50%;
    display: inline-block; margin-left: 6px;
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; } 50% { opacity: 0.3; }
  }

  /* Responsive */
  @media (max-width: 768px) {
    nav { padding: 16px 20px; }
    .nav-links { display: none; }
    .hero { padding: 100px 20px 60px; }
    .products-grid { padding: 0 16px; grid-template-columns: repeat(2, 1fr); }
    .section-header, .filter-bar { padding-left: 16px; padding-right: 16px; }
    .brand-strip { padding: 30px 20px; }
    footer { padding: 40px 20px 24px; }
    .admin-content { padding: 16px; }
  }
  @media (max-width: 480px) {
    .products-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
  
<!-- Cursor -->
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<!-- ============================================================ -->
<!-- STORE PAGE -->
<!-- ============================================================ -->
<div class="page active" id="storePage">

  <!-- Navbar -->
  <nav>
    <div class="nav-logo" onclick="scrollTo(0,0)">SANJHEX</div>
    <ul class="nav-links">
      <li><a onclick="filterProducts('all')">All</a></li>
      <li><a onclick="filterProducts('tops')">Tops</a></li>
      <li><a onclick="filterProducts('bottoms')">Bottoms</a></li>
      <li><a onclick="filterProducts('accessories')">Accessories</a></li>
      <li><a onclick="filterProducts('outerwear')">Outerwear</a></li>
    </ul>
    <div class="nav-right">
      <button class="cart-btn" onclick="openCart()">
        BAG <span class="cart-count" id="cartCount">0</span>
      </button>
      <button style="background:none;border:1px solid var(--border);color:var(--muted);padding:10px 16px;font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:1px;cursor:pointer;transition:all 0.2s;" 
              onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'"
              onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--muted)'"
              onclick="showPage('loginPage')">ADMIN</button>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>
    <div class="hero-content">
      <div class="hero-tag">New Drop 2025</div>
      <h1>WEAR YOUR<br><span>IDENTITY</span></h1>
      <p>Unisex streetwear crafted for those who live between labels. Bold cuts. Raw textures. Unapologetic design.</p>
      <div class="hero-btns">
        <button class="btn-primary" onclick="scrollToProducts()">SHOP NOW</button>
        <button class="btn-outline" onclick="filterProducts('new')">NEW ARRIVALS</button>
      </div>
    </div>
    <div class="hero-marquee">
      <div class="marquee-track" id="marqueeTrack">
        <span class="marquee-item"><span>✦</span>SANJHEX</span>
        <span class="marquee-item"><span>✦</span>UNISEX STREETWEAR</span>
        <span class="marquee-item"><span>✦</span>FREE SHIP OVER ₹999</span>
        <span class="marquee-item"><span>✦</span>NEW DROP 2025</span>
        <span class="marquee-item"><span>✦</span>MADE FOR ALL</span>
        <span class="marquee-item"><span>✦</span>SANJHEX</span>
        <span class="marquee-item"><span>✦</span>UNISEX STREETWEAR</span>
        <span class="marquee-item"><span>✦</span>FREE SHIP OVER ₹999</span>
        <span class="marquee-item"><span>✦</span>NEW DROP 2025</span>
        <span class="marquee-item"><span>✦</span>MADE FOR ALL</span>
      </div>
    </div>
  </section>

  <!-- Products Section -->
  <div id="productsSection">
    <div class="section-header">
      <div>
        <div class="section-label">The Collection</div>
        <div class="section-title">ALL DROPS</div>
      </div>
      <button class="view-all" onclick="filterProducts('all')">VIEW ALL</button>
    </div>

    <div class="filter-bar">
      <span class="filter-label">Filter:</span>
      <button class="filter-btn active" onclick="setFilter(this,'all')">All</button>
      <button class="filter-btn" onclick="setFilter(this,'tops')">Tops</button>
      <button class="filter-btn" onclick="setFilter(this,'bottoms')">Bottoms</button>
      <button class="filter-btn" onclick="setFilter(this,'outerwear')">Outerwear</button>
      <button class="filter-btn" onclick="setFilter(this,'accessories')">Accessories</button>
      <button class="filter-btn" onclick="setFilter(this,'new')">New In</button>
    </div>

    <div class="products-grid" id="productsGrid"></div>
  </div>

  <!-- Brand Strip -->
  <div class="brand-strip">
    <div class="strip-item">
      <div class="strip-num">100%</div>
      <div class="strip-text">Unisex Fits</div>
    </div>
    <div class="strip-item">
      <div class="strip-num">3-5</div>
      <div class="strip-text">Day Delivery</div>
    </div>
    <div class="strip-item">
      <div class="strip-num">Free</div>
      <div class="strip-text">Returns 7 Days</div>
    </div>
    <div class="strip-item">
      <div class="strip-num">UPI</div>
      <div class="strip-text">Instant Pay</div>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <div class="footer-grid">
      <div>
        <div class="footer-brand">SANJHEX</div>
        <div class="footer-desc">Unisex streetwear for the ones who exist beyond labels. Drop-based collections, limited pieces.</div>
      </div>
      <div>
        <div class="footer-heading">Quick Links</div>
        <ul class="footer-links">
          <li><a onclick="filterProducts('all')">Shop All</a></li>
          <li><a onclick="filterProducts('new')">New Arrivals</a></li>
          <li><a onclick="filterProducts('tops')">Tops</a></li>
          <li><a onclick="filterProducts('bottoms')">Bottoms</a></li>
        </ul>
      </div>
      <div>
        <div class="footer-heading">Help</div>
        <ul class="footer-links">
          <li><a href="#">Sizing Guide</a></li>
          <li><a href="#">Shipping Info</a></li>
          <li><a href="#">Returns</a></li>
          <li><a href="mailto:sanjhex@gmail.com">Contact Us</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-copy">© 2025 SANJHEX. All rights reserved.</div>
      <div class="footer-copy">Made with ✦ in India</div>
    </div>
  </footer>
</div>

<!-- ============================================================ -->
<!-- CART SIDEBAR -->
<!-- ============================================================ -->
<div class="cart-overlay" id="cartOverlay" onclick="closeCart()"></div>
<div class="cart-sidebar" id="cartSidebar">
  <div class="cart-header">
    <div class="cart-title">YOUR BAG</div>
    <button class="close-cart" onclick="closeCart()">✕</button>
  </div>
  <div class="cart-items" id="cartItems">
    <div class="cart-empty" id="cartEmpty">YOUR BAG IS EMPTY<br><br>Start shopping →</div>
  </div>
  <div class="cart-footer" id="cartFooter" style="display:none;">
    <div class="cart-subtotal">
      <span>Subtotal</span>
      <span id="cartTotal">₹0</span>
    </div>
    <div class="cart-note">Taxes & shipping calculated at checkout</div>
    <button class="checkout-btn" onclick="openCheckout()">PROCEED TO CHECKOUT</button>
  </div>
</div>

<!-- ============================================================ -->
<!-- PRODUCT DETAIL MODAL -->
<!-- ============================================================ -->
<div class="modal-overlay" id="productModal">
  <div class="modal" style="max-width:700px;">
    <div class="modal-header">
      <div class="modal-title" id="pdTitle">Product</div>
      <button class="close-modal" onclick="closeProductModal()">✕</button>
    </div>
    <div class="product-modal-body">
      <div class="product-modal-img">
        <img src="" alt="" id="pdImg" onerror="this.style.display='none'">
      </div>
      <div class="product-modal-info">
        <div class="product-modal-name" id="pdName"></div>
        <div class="product-modal-price" id="pdPrice"></div>
        <div class="product-modal-desc" id="pdDesc"></div>
        <div class="size-label">SELECT SIZE</div>
        <div class="size-options" id="pdSizes"></div>
        <button class="add-to-cart-main" onclick="addToCartFromModal()">ADD TO BAG</button>
        <button class="buy-now-main" onclick="buyNowFromModal()">BUY NOW</button>
      </div>
    </div>
  </div>
                </div>
                <!-- ============================================================ -->
<!-- CHECKOUT MODAL -->
<!-- ============================================================ -->
<div class="modal-overlay" id="checkoutModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">CHECKOUT</div>
      <button class="close-modal" onclick="closeCheckout()">✕</button>
    </div>
    <div class="modal-body" id="checkoutBody">
      <!-- Order Summary -->
      <div class="order-summary">
        <div class="order-summary-title">Order Summary</div>
        <div id="checkoutItems"></div>
        <div class="order-row" style="color:var(--muted);font-size:0.8rem;margin-top:6px;">
          <span>Shipping</span><span id="checkoutShipping">FREE</span>
        </div>
        <div class="order-row total">
          <span>Total</span><span id="checkoutTotal">₹0</span>
        </div>
      </div>

      <!-- Form -->
      <div class="form-group">
        <label class="form-label">Full Name</label>
        <input class="form-input" id="cName" placeholder="Your full name" type="text">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Phone</label>
          <input class="form-input" id="cPhone" placeholder="10-digit number" type="tel">
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input class="form-input" id="cEmail" placeholder="email@example.com" type="email">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Address</label>
        <input class="form-input" id="cAddress" placeholder="Flat, Street, Area" type="text">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">City</label>
          <input class="form-input" id="cCity" placeholder="City" type="text">
        </div>
        <div class="form-group">
          <label class="form-label">PIN Code</label>
          <input class="form-input" id="cPin" placeholder="6-digit PIN" type="text">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">State</label>
        <select class="form-select" id="cState">
          <option value="">Select State</option>
          <option>Andhra Pradesh</option><option>Assam</option><option>Bihar</option>
          <option>Delhi</option><option>Goa</option><option>Gujarat</option>
          <option>Haryana</option><option>Himachal Pradesh</option><option>Jharkhand</option>
          <option>Karnataka</option><option>Kerala</option><option>Madhya Pradesh</option>
          <option>Maharashtra</option><option>Manipur</option><option>Meghalaya</option>
          <option>Odisha</option><option>Punjab</option><option>Rajasthan</option>
          <option>Tamil Nadu</option><option>Telangana</option><option>Uttar Pradesh</option>
          <option>Uttarakhand</option><option>West Bengal</option><option>Other</option>
        </select>
      </div>

      <!-- UPI Box -->
      <div class="upi-box">
        <div class="upi-title">⚡ Pay via UPI</div>
        <div class="upi-id" id="storeUpiId">sanjhex@upi</div>
        <div class="upi-note">Open any UPI app (GPay, PhonePe, Paytm, etc.)<br>Search this UPI ID and pay the exact amount.<br>Then click the button below to confirm.</div>
      </div>

      <button class="pay-btn" onclick="placeOrder()">
        ✦ PAY NOW — UPI
      </button>
    </div>

    <!-- Success State -->
    <div class="success-modal" id="successBody" style="display:none;">
      <div class="success-icon">✓</div>
      <div class="success-title">ORDER PLACED!</div>
      <div class="success-msg">Thank you! Your order is confirmed. We'll send tracking details on your phone shortly.</div>
      <div class="order-id" id="successOrderId"></div>
      <button class="btn-primary" onclick="closeCheckout(); clearCart();">CONTINUE SHOPPING</button>
    </div>
  </div>
</div>

<!-- ============================================================ -->
<!-- LOGIN PAGE -->
<!-- ============================================================ -->
<div class="page" id="loginPage">
  <div class="login-page">
    <div class="login-box">
      <div class="login-logo">SANJHEX</div>
      <div class="login-sub">Admin Panel</div>
      <div class="form-group">
        <label class="form-label">Username</label>
        <input class="form-input" id="loginUser" placeholder="admin" type="text">
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input class="form-input" id="loginPass" placeholder="••••••••" type="password"
               onkeydown="if(event.key==='Enter') adminLogin()">
      </div>
      <button class="login-btn" onclick="adminLogin()">LOGIN TO ADMIN</button>
      <div class="login-err" id="loginErr">Invalid credentials. Try again.</div>
      <div style="margin-top:20px;text-align:center;">
        <button onclick="showPage('storePage')" 
                style="background:none;border:none;color:var(--muted);font-size:0.72rem;cursor:pointer;font-family:'Space Mono',monospace;letter-spacing:1px;">
          ← BACK TO STORE
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================ -->
<!-- ADMIN PAGE -->
<!-- ============================================================ -->
<div class="page" id="adminPage">
  <div class="admin-page">
    <div class="admin-nav">
      <div class="admin-logo">SANJHEX <span>ADMIN</span></div>
      <div style="display:flex;gap:12px;align-items:center;">
        <button onclick="showPage('storePage')" 
                style="background:none;border:1px solid var(--border);color:var(--muted);padding:8px 14px;font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:1px;cursor:pointer;transition:all 0.2s;"
                onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'"
                onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--muted)'">
          VIEW STORE
        </button>
        <button class="admin-logout" onclick="adminLogout()">LOGOUT</button>
      </div>
    </div>

    <div class="admin-layout">
      <!-- Sidebar -->
      <div class="admin-sidebar">
        <div class="admin-menu-item active" onclick="switchAdmin('dashboard',this)">
          <span class="admin-menu-icon">◈</span> Dashboard
        </div>
        <div class="admin-menu-item" onclick="switchAdmin('products',this)">
          <span class="admin-menu-icon">◉</span> Products
        </div>
        <div class="admin-menu-item" onclick="switchAdmin('orders',this)">
          <span class="admin-menu-icon">◎</span> Orders <span class="notif-dot" id="orderDot"></span>
        </div>
        <div class="admin-menu-item" onclick="switchAdmin('settings',this)">
          <span class="admin-menu-icon">◈</span> Settings
        </div>
      </div>

      <!-- Content -->
      <div class="admin-content">
                <!-- Dashboard -->
        <div class="admin-section active" id="admin-dashboard">
          <div class="admin-title">DASHBOARD</div>
          <div class="admin-subtitle">Your store at a glance</div>
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-label">Total Products</div>
              <div class="stat-val" id="statProducts">0</div>
              <div class="stat-change">Active in store</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Total Orders</div>
              <div class="stat-val" id="statOrders">0</div>
              <div class="stat-change">All time</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Revenue</div>
              <div class="stat-val" id="statRevenue">₹0</div>
              <div class="stat-change">All time</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">UPI ID</div>
              <div class="stat-val" style="font-size:1rem;letter-spacing:1px;" id="statUpi">—</div>
              <div class="stat-change">Payment ID</div>
            </div>
          </div>
          <div style="background:var(--surface);border:1px solid var(--border);padding:20px;">
            <div style="font-family:'Space Mono',monospace;font-size:0.65rem;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:14px;">Recent Orders</div>
            <div id="dashboardOrders"></div>
          </div>
        </div>

        <!-- Products -->
        <div class="admin-section" id="admin-products">
          <div class="admin-title">PRODUCTS</div>
          <div class="admin-subtitle">Manage your store inventory</div>

          <!-- Add / Edit Form -->
          <div class="admin-form" id="productForm" style="display:none;">
            <div class="admin-form-title" id="formTitle">ADD NEW PRODUCT</div>
            <input type="hidden" id="editProductId">
            <div class="admin-form-grid">
              <div class="form-group">
                <label class="form-label">Product Name</label>
                <input class="form-input" id="pName" placeholder="e.g. Oversized Drop Tee">
              </div>
              <div class="form-group">
                <label class="form-label">Price (₹)</label>
                <input class="form-input" id="pPrice" placeholder="e.g. 1299" type="number">
              </div>
              <div class="form-group">
                <label class="form-label">Original Price (₹) — optional</label>
                <input class="form-input" id="pOriginal" placeholder="e.g. 1799" type="number">
              </div>
              <div class="form-group">
                <label class="form-label">Category</label>
                <select class="form-select" id="pCategory">
                  <option value="tops">Tops</option>
                  <option value="bottoms">Bottoms</option>
                  <option value="outerwear">Outerwear</option>
                  <option value="accessories">Accessories</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Sizes (comma separated)</label>
                <input class="form-input" id="pSizes" placeholder="XS, S, M, L, XL, XXL">
              </div>
              <div class="form-group">
                <label class="form-label">Badge</label>
                <select class="form-select" id="pBadge">
                  <option value="">None</option>
                  <option value="NEW">New</option>
                  <option value="HOT">Hot</option>
                  <option value="SALE">Sale</option>
                  <option value="LIMITED">Limited</option>
                </select>
              </div>
              <div class="form-group admin-form-full">
                <label class="form-label">Description</label>
                <textarea class="form-input" id="pDesc" placeholder="Describe the product..."></textarea>
              </div>
              <div class="form-group admin-form-full">
                <label class="form-label">Product Image URL</label>
                <input class="form-input" id="pImgUrl" placeholder="https://... or leave blank for placeholder">
              </div>
            </div>
            <div>
              <button class="admin-save" onclick="saveProduct()">SAVE PRODUCT</button>
              <button class="admin-cancel" onclick="hideProductForm()">CANCEL</button>
            </div>
          </div>

          <!-- Products Table -->
          <div class="products-table">
            <div class="table-header">
              <span class="table-title">All Products (<span id="productCount">0</span>)</span>
              <button class="add-product-btn" onclick="showProductForm()">+ ADD PRODUCT</button>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>IMG</th>
                    <th>NAME</th>
                    <th>CATEGORY</th>
                    <th>PRICE</th>
                    <th>BADGE</th>
                    <th>ACTIONS</th>
                  </tr>
                </thead>
                <tbody id="productsTableBody"></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Orders -->
        <div class="admin-section" id="admin-orders">
          <div class="admin-title">ORDERS</div>
          <div class="admin-subtitle">Track and manage customer orders</div>
          <div id="ordersListAdmin"></div>
        </div>

        <!-- Settings -->
        <div class="admin-section" id="admin-settings">
          <div class="admin-title">SETTINGS</div>
          <div class="admin-subtitle">Configure your store</div>

          <div class="settings-section">
            <div class="settings-heading">UPI PAYMENT</div>
            <div class="form-group">
              <label class="form-label">Your UPI ID</label>
              <input class="form-input" id="settingsUpi" placeholder="yourname@upi" type="text">
            </div>
            <div class="form-group">
              <label class="form-label">Store Name (Display)</label>
              <input class="form-input" id="settingsStoreName" placeholder="SANJHEX">
            </div>
            <button class="admin-save" onclick="saveSettings()">SAVE SETTINGS</button>
          </div>

          <div class="settings-section">
            <div class="settings-heading">ADMIN CREDENTIALS</div>
            <div class="form-group">
              <label class="form-label">Username</label>
              <input class="form-input" id="settingsUser" type="text">
            </div>
            <div class="form-group">
              <label class="form-label">New Password</label>
              <input class="form-input" id="settingsPass" type="password" placeholder="Leave blank to keep current">
            </div>
            <button class="admin-save" onclick="saveCredentials()">UPDATE CREDENTIALS</button>
          </div>
        </div>

      </div><!-- /admin-content -->
    </div><!-- /admin-layout -->
  </div>
</div>

<!-- ============================================================ -->
<!-- SCRIPT -->
<!-- ============================================================ -->
<script>
// ========== STATE ==========
let cart = JSON.parse(localStorage.getItem('sanjhex_cart') || '[]');
let products = JSON.parse(localStorage.getItem('sanjhex_products') || 'null');
let orders = JSON.parse(localStorage.getItem('sanjhex_orders') || '[]');
let settings = JSON.parse(localStorage.getItem('sanjhex_settings') || 'null');
let adminCreds = JSON.parse(localStorage.getItem('sanjhex_creds') || 'null');
let currentProductId = null;
let selectedSize = '';

// Init defaults
if (!settings) {
  settings = { upiId: 'sanjhex@upi', storeName: 'SANJHEX' };
  localStorage.setItem('sanjhex_settings', JSON.stringify(settings));
}
if (!adminCreds) {
  adminCreds = { user: 'admin', pass: 'sanjhex2025' };
  localStorage.setItem('sanjhex_creds', JSON.stringify(adminCreds));
}
if (!products) {
  products = [
    {
      id: 'p1', name: 'Void Drop Oversized Tee', price: 1299, original: 1799,
      category: 'tops', sizes: ['XS','S','M','L','XL','XXL'], badge: 'NEW',
      desc: 'Ultra-oversized unisex tee with pigment wash. 100% heavyweight cotton. Dropped shoulders, raw hem detail.',
      img: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=600&q=80'
    },
    {
      id: 'p2', name: 'Shadow Cargo Pants', price: 2499, original: 3200,
      category: 'bottoms', sizes: ['XS','S','M','L','XL'], badge: 'HOT',
      desc: 'Wide-leg cargo with multi-pocket utility design. Unisex fit. Ripstop cotton blend.',
      img: 'https://images.unsplash.com/photo-1605518216938-7c31b7b14ad0?w=600&q=80'
    },
    {
      id: 'p3', name: 'Hex Block Hoodie', price: 1899, original: null,
      category: 'tops', sizes: ['S','M','L','XL','XXL'], badge: '',
      desc: 'Double-layered hood, kangaroo pocket, ribbed cuffs. Heavyweight fleece. Unisex relaxed fit.',
      img: 'https://images.unsplash.com/photo-1556821840-3a63f15732ce?w=600&q=80'
    },
    {
      id: 'p4', name: 'Distressed Utility Jacket', price: 3499, original: null,
      category: 'outerwear', sizes: ['S','M','L','XL'], badge: 'LIMITED',
      desc: 'Vintage wash jacket with contrast stitching. 4 utility pockets. Unisex street-ready silhouette.',
      img: 'https://images.unsplash.com/photo-1591047139829-d91aecb6caea?w=600&q=80'
    },
    {
      id: 'p5', name: 'Worn Wash Shorts', price: 999, original: 1299,
      category: 'bottoms', sizes: ['XS','S','M','L','XL','XXL'], badge: 'SALE',
      desc: 'Relaxed cut with elasticated waist. Stone-washed cotton. Unisex streetwear essential.',
      img: 'https://images.unsplash.com/photo-1594938298603-c8148c4b4571?w=600&q=80'
    },
    {
      id: 'p6', name: 'Six-Panel Struct Cap', price: 699, original: null,
      category: 'accessories', sizes: ['ONE SIZE'], badge: '',
      desc: 'Structured 6-panel cap with tonal SANJHEX embroidery. Adjustable strap. Unisex.',
      img: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600&q=80'
    },
  ];
  localStorage.setItem('sanjhex_products', JSON.stringify(products));
}

// ========== CURSOR ==========
const cursor = document.getElementById('cursor');
const cursorRing = document.getElementById('cursorRing');
let mx = 0, my = 0, rx = 0, ry = 0;
document.addEventListener('mousemove', e => {
  mx = e.clientX; my = e.clientY;
  cursor.style.left = mx - 6 + 'px';
  cursor.style.top = my - 6 + 'px';
});
function animRing() {
  rx += (mx - rx - 18) * 0.15;
  ry += (my - ry - 18) * 0.15;
  cursorRing.style.left = rx + 'px';
  cursorRing.style.top = ry + 'px';
  requestAnimationFrame(animRing);
}
animRing();

// ========== PAGES ==========
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0,0);
}

// ========== TOAST ==========
let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
}

// ========== PRODUCTS ==========
let currentFilter = 'all';
function renderProducts(filter = 'all') {
  currentFilter = filter;
  const grid = document.getElementById('productsGrid');
  const filtered = filter === 'all' ? products
    : filter === 'new' ? products.filter(p => p.badge === 'NEW')
    : products.filter(p => p.category === filter);

  if (!filtered.length) {
    grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--muted);font-family:Space Mono,monospace;font-size:0.8rem;letter-spacing:2px;">NO PRODUCTS IN THIS CATEGORY YET</div>';
    return;
  }

  grid.innerHTML = filtered.map(p => `
    <div class="product-card" onclick="openProductModal('${p.id}')">
      <div class="product-img-placeholder">
        ${p.badge ? `<div class="product-badge ${p.badge==='SALE'?'sale':''}">${p.badge}</div>` : ''}
        ${p.img ? `<img src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.style.display='none'">` : `<span>${p.name.slice(0,3).toUpperCase()}</span>`}
        <div class="product-overlay">
          <button class="overlay-btn" onclick="event.stopPropagation();quickAdd('${p.id}')">QUICK ADD</button>
          <button class="overlay-btn outline" onclick="event.stopPropagation();openProductModal('${p.id}')">VIEW DETAILS</button>
        </div>
      </div>
      <div class="product-info">
        <div class="product-name">${p.name}</div>
        <div class="product-meta">
          <div class="product-price">
            ${p.original ? `<span class="original">₹${p.original.toLocaleString('en-IN')}</span>` : ''}
            ₹${p.price.toLocaleString('en-IN')}
          </div>
          <div class="product-sizes">${p.sizes.slice(0,4).join(' · ')}${p.sizes.length>4?'…':''}</div>
        </div>
      </div>
    </div>
  `).join('');
}

function filterProducts(f) {
  setFilter(null, f);
  scrollToProducts();
}
function setFilter(btn, f) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  else {
    document.querySelectorAll('.filter-btn').forEach(b => {
      if(b.textContent.toLowerCase().includes(f) || (f==='all' && b.textContent==='All')) b.classList.add('active');
    });
  }
  renderProducts(f);
}
function scrollToProducts() {
  document.getElementById('productsSection').scrollIntoView({ behavior: 'smooth' });
}

// ========== PRODUCT MODAL ==========
let modalProduct = null;
function openProductModal(id) {
  modalProduct = products.find(p => p.id === id);
  if (!modalProduct) return;
  currentProductId = id;
  selectedSize = '';

  document.getElementById('pdTitle').textContent = modalProduct.name;
  document.getElementById('pdName').textContent = modalProduct.name;
  document.getElementById('pdPrice').innerHTML = `
    ${modalProduct.original ? `<span style="color:var(--muted);text-decoration:line-through;font-size:0.9rem;margin-right:8px;">₹${modalProduct.original.toLocaleString('en-IN')}</span>` : ''}
    ₹${modalProduct.price.toLocaleString('en-IN')}
  `;
  document.getElementById('pdDesc').textContent = modalProduct.desc;
  const img = document.getElementById('pdImg');
  if (modalProduct.img) { img.src = modalProduct.img; img.style.display = 'block'; }
  else img.style.display = 'none';

  document.getElementById('pdSizes').innerHTML = modalProduct.sizes.map(s =>
    `<button class="size-opt" onclick="selectSize(this,'${s}')">${s}</button>`
  ).join('');

  document.getElementById('productModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeProductModal() {
  document.getElementById('productModal').classList.remove('open');
  document.body.style.overflow = '';
}
function selectSize(btn, s) {
  document.querySelectorAll('.size-opt').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  selectedSize = s;
}
function addToCartFromModal() {
  if (!modalProduct) return;
  if (modalProduct.sizes.length > 1 && !selectedSize) {
    showToast('Please select a size first!');
    return;
  }
  const size = selectedSize || modalProduct.sizes[0];
  addToCart(modalProduct, size);
  closeProductModal();
}
function buyNowFromModal() {
  if (!modalProduct) return;
  if (modalProduct.sizes.length > 1 && !selectedSize) {
    showToast('Please select a size first!');
    return;
  }
  const size = selectedSize || modalProduct.sizes[0];
  addToCart(modalProduct, size);
  closeProductModal();
  closeCart();
  openCheckout();
}

// ========== QUICK ADD ==========
function quickAdd(id) {
  const p = products.find(pr => pr.id === id);
  if (!p) return;
  if (p.sizes.length > 1) { openProductModal(id); return; }
  addToCart(p, p.sizes[0]);
}

// ========== CART ==========
function addToCart(product, size) {
  const key = product.id + '_' + size;
  const existing = cart.find(i => i.key === key);
  if (existing) existing.qty++;
  else cart.push({ key, id: product.id, name: product.name, price: product.price, size, qty: 1, img: product.img });
  saveCart();
  updateCartUI();
  showToast(product.name + ' added to bag!');
}
function removeFromCart(key) {
  cart = cart.filter(i => i.key !== key);
  saveCart();
  updateCartUI();
}
function changeQty(key, delta) {
  const item = cart.find(i => i.key === key);
  if (!item) return;
  item.qty += delta;
  if (item.qty <= 0) removeFromCart(key);
  else { saveCart(); updateCartUI(); }
}
function saveCart() {
  localStorage.setItem('sanjhex_cart', JSON.stringify(cart));
}
function clearCart() {
  cart = [];
  saveCart();
  updateCartUI();
}
function getCartTotal() {
  return cart.reduce((s, i) => s + i.price * i.qty, 0);
}
function updateCartUI() {
  const count = cart.reduce((s, i) => s + i.qty, 0);
  document.getElementById('cartCount').textContent = count;

  const empty = document.getElementById('cartEmpty');
  const footer = document.getElementById('cartFooter');
  const itemsEl = document.getElementById('cartItems');

  if (!cart.length) {
    empty.style.display = 'block';
    footer.style.display = 'none';
    itemsEl.innerHTML = '';
    itemsEl.appendChild(empty);
    return;
  }
  empty.style.display = 'none';
  footer.style.display = 'block';

  itemsEl.innerHTML = cart.map(item => `
    <div class="cart-item">
      <div class="cart-item-img">
        ${item.img ? `<img src="${item.img}" alt="${item.name}" onerror="this.style.display='none'">` : ''}
      </div>
      <div class="cart-item-details">
        <div class="cart-item-name">${item.name}</div>
        <div class="cart-item-size">Size: ${item.size}</div>
        <div class="cart-item-qty">
          <button class="qty-btn" onclick="changeQty('${item.key}',-1)">−</button>
          <span class="qty-num">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty('${item.key}',1)">+</button>
        </div>
      </div>
      <div class="cart-item-price">₹${(item.price*item.qty).toLocaleString('en-IN')}</div>
      <button class="remove-item" onclick="removeFromCart('${item.key}')">✕</button>
    </div>
  `).join('');

  document.getElementById('cartTotal').textContent = '₹' + getCartTotal().toLocaleString('en-IN');
}
function openCart() {
  document.getElementById('cartOverlay').classList.add('open');
  document.getElementById('cartSidebar').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeCart() {
  document.getElementById('cartOverlay').classList.remove('open');
  document.getElementById('cartSidebar').classList.remove('open');
  document.body.style.overflow = '';
}

// ========== CHECKOUT ==========
function openCheckout() {
  if (!cart.length) { showToast('Your bag is empty!'); return; }

  // Populate order summary
  document.getElementById('checkoutItems').innerHTML = cart.map(i =>
    `<div class="order-row"><span>${i.name} (${i.size}) × ${i.qty}</span><span>₹${(i.price*i.qty).toLocaleString('en-IN')}</span></div>`
  ).join('');

  const total = getCartTotal();
  document.getElementById('checkoutShipping').textContent = total >= 999 ? 'FREE' : '₹79';
  const grandTotal = total >= 999 ? total : total + 79;
  document.getElementById('checkoutTotal').textContent = '₹' + grandTotal.toLocaleString('en-IN');
  document.getElementById('storeUpiId').textContent = settings.upiId;

  document.getElementById('checkoutBody').style.display = 'block';
  document.getElementById('successBody').style.display = 'none';
  document.getElementById('checkoutModal').classList.add('open');
  document.body.style.overflow = 'hidden';
  closeCart();
}
function closeCheckout() {
  document.getElementById('checkoutModal').classList.remove('open');
  document.body.style.overflow = '';
}
function placeOrder() {
  const name = document.getElementById('cName').value.trim();
  const phone = document.getElementById('cPhone').value.trim();
  const address = document.getElementById('cAddress').value.trim();
  const city = document.getElementById('cCity').value.trim();
  const pin = document.getElementById('cPin').value.trim();
  const state = document.getElementById('cState').value;

  if (!name || !phone || !address || !city || !pin || !state) {
    showToast('Please fill all required fields!');
    return;
  }
  if (!/^\d{10}$/.test(phone)) {
    showToast('Enter a valid 10-digit phone number!');
    return;
  }
  if (!/^\d{6}$/.test(pin)) {
    showToast('Enter a valid 6-digit PIN code!');
    return;
  }

  const total = getCartTotal();
  const shipping = total >= 999 ? 0 : 79;
  const orderId = 'SJX' + Date.now().toString().slice(-6);

  const order = {
    id: orderId,
    customer: { name, phone, address: `${address}, ${city} - ${pin}, ${state}` },
    items: [...cart],
    total: total + shipping,
    shipping,
    date: new Date().toLocaleDateString('en-IN'),
    time: new Date().toLocaleTimeString('en-IN'),
    status: 'Pending'
  };

  orders.unshift(order);
  localStorage.setItem('sanjhex_orders', JSON.stringify(orders));

  document.getElementById('successOrderId').textContent = 'Order ID: ' + orderId;
  document.getElementById('checkoutBody').style.display = 'none';
  document.getElementById('successBody').style.display = 'block';
}

// ========== ADMIN ==========
function adminLogin() {
  const u = document.getElementById('loginUser').value.trim();
  const p = document.getElementById('loginPass').value;
  const err = document.getElementById('loginErr');
  if (u === adminCreds.user && p === adminCreds.pass) {
    err.classList.remove('show');
    showPage('adminPage');
    renderAdmin();
  } else {
    err.classList.add('show');
  }
}
function adminLogout() {
  document.getElementById('loginUser').value = '';
  document.getElementById('loginPass').value = '';
  showPage('storePage');
}
function switchAdmin(section, el) {
  document.querySelectorAll('.admin-menu-item').forEach(i => i.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.admin-section').forEach(s => s.classList.remove('active'));
  document.getElementById('admin-' + section).classList.add('active');
  if (section === 'products') renderAdminProducts();
  if (section === 'orders') renderAdminOrders();
  if (section === 'settings') loadSettings();
}
function renderAdmin() {
  // Reload data
  orders = JSON.parse(localStorage.getItem('sanjhex_orders') || '[]');
  products = JSON.parse(localStorage.getItem('sanjhex_products') || '[]');
  settings = JSON.parse(localStorage.getItem('sanjhex_settings') || '{}');

  // Stats
  const revenue = orders.reduce((s, o) => s + o.total, 0);
  document.getElementById('statProducts').textContent = products.length;
  document.getElementById('statOrders').textContent = orders.length;
  document.getElementById('statRevenue').textContent = '₹' + revenue.toLocaleString('en-IN');
  document.getElementById('statUpi').textContent = settings.upiId || '—';

  // Recent orders
  const dash = document.getElementById('dashboardOrders');
  if (!orders.length) {
    dash.innerHTML = '<div style="color:var(--muted);font-size:0.8rem;padding:10px 0;">No orders yet.</div>';
    return;
  }
  dash.innerHTML = orders.slice(0,5).map(o => `
    <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);flex-wrap:wrap;gap:8px;">
      <div>
        <div style="font-family:'Space Mono',monospace;font-size:0.7rem;color:var(--accent);">${o.id}</div>
        <div style="font-size:0.82rem;">${o.customer.name}</div>
        <div style="font-size:0.7rem;color:var(--muted);">${o.date}</div>
      </div>
      <div style="font-family:'Space Mono',monospace;color:var(--accent);font-weight:700;">₹${o.total.toLocaleString('en-IN')}</div>
      <div style="font-size:0.7rem;font-family:'Space Mono',monospace;color:var(--muted);">${o.status}</div>
    </div>
  `).join('');
}

// Products Admin
function renderAdminProducts() {
  products = JSON.parse(localStorage.getItem('sanjhex_products') || '[]');
  document.getElementById('productCount').textContent = products.length;
  const tbody = document.getElementById('productsTableBody');
  tbody.innerHTML = products.map(p => `
    <tr>
      <td>
        <div class="td-img">
          ${p.img ? `<img src="${p.img}" alt="${p.name}" onerror="this.style.display='none'">` : ''}
        </div>
      </td>
      <td style="max-width:200px;">${p.name}</td>
      <td style="text-transform:capitalize;">${p.category}</td>
      <td style="font-family:'Space Mono',monospace;">₹${p.price.toLocaleString('en-IN')}</td>
      <td>${p.badge ? `<span class="td-badge active">${p.badge}</span>` : '<span class="td-badge inactive">—</span>'}</td>
      <td>
        <button class="table-action" onclick="editProduct('${p.id}')">Edit</button>
        <button class="table-action del" onclick="deleteProduct('${p.id}')">Delete</button>
      </td>
    </tr>
  `).join('');
  if (!products.length) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:30px;color:var(--muted);font-family:Space Mono,monospace;font-size:0.75rem;letter-spacing:2px;">NO PRODUCTS YET — ADD YOUR FIRST!</td></tr>';
  }
}
function showProductForm(reset=true) {
  if(reset) {
    document.getElementById('formTitle').textContent = 'ADD NEW PRODUCT';
    document.getElementById('editProductId').value = '';
    document.getElementById('pName').value = '';
    document.getElementById('pPrice').value = '';
    document.getElementById('pOriginal').value = '';
    document.getElementById('pCategory').value = 'tops';
    document.getElementById('pSizes').value = 'XS, S, M, L, XL, XXL';
    document.getElementById('pBadge').value = '';
    document.getElementById('pDesc').value = '';
    document.getElementById('pImgUrl').value = '';
  }
  document.getElementById('productForm').style.display = 'block';
  document.getElementById('productForm').scrollIntoView({behavior:'smooth'});
}
function hideProductForm() {
  document.getElementById('productForm').style.display = 'none';
}
function editProduct(id) {
  const p = products.find(x => x.id === id);
  if (!p) return;
  document.getElementById('formTitle').textContent = 'EDIT PRODUCT';
  document.getElementById('editProductId').value = p.id;
  document.getElementById('pName').value = p.name;
  document.getElementById('pPrice').value = p.price;
  document.getElementById('pOriginal').value = p.original || '';
  document.getElementById('pCategory').value = p.category;
  document.getElementById('pSizes').value = p.sizes.join(', ');
  document.getElementById('pBadge').value = p.badge || '';
  document.getElementById('pDesc').value = p.desc;
  document.getElementById('pImgUrl').value = p.img || '';
  showProductForm(false);
}
function saveProduct() {
  const name = document.getElementById('pName').value.trim();
  const price = parseInt(document.getElementById('pPrice').value);
  const original = parseInt(document.getElementById('pOriginal').value) || null;
  const category = document.getElementById('pCategory').value;
  const sizesRaw = document.getElementById('pSizes').value;
  const sizes = sizesRaw.split(',').map(s=>s.trim()).filter(Boolean);
  const badge = document.getElementById('pBadge').value;
  const desc = document.getElementById('pDesc').value.trim();
  const img = document.getElementById('pImgUrl').value.trim();
  const editId = document.getElementById('editProductId').value;

  if (!name || !price || !sizes.length) { showToast('Fill Name, Price and Sizes!'); return; }

  if (editId) {
    const idx = products.findIndex(p => p.id === editId);
    if (idx > -1) products[idx] = { id: editId, name, price, original, category, sizes, badge, desc, img };
  } else {
    products.push({ id: 'p' + Date.now(), name, price, original, category, sizes, badge, desc, img });
  }
  localStorage.setItem('sanjhex_products', JSON.stringify(products));
  renderAdminProducts();
  renderProducts(currentFilter);
  hideProductForm();
  showToast(editId ? 'Product updated!' : 'Product added!');
}
function deleteProduct(id) {
  if (!confirm('Delete this product?')) return;
  products = products.filter(p => p.id !== id);
  localStorage.setItem('sanjhex_products', JSON.stringify(products));
  renderAdminProducts();
  renderProducts(currentFilter);
  showToast('Product deleted.');
}

// Orders Admin
function renderAdminOrders() {
  orders = JSON.parse(localStorage.getItem('sanjhex_orders') || '[]');
  const el = document.getElementById('ordersListAdmin');
  if (!orders.length) {
    el.innerHTML = '<div style="color:var(--muted);font-family:Space Mono,monospace;font-size:0.8rem;letter-spacing:2px;padding:30px 0;">NO ORDERS YET</div>';
    return;
  }
  el.innerHTML = orders.map(o => `
    <div class="order-row-item">
      <div class="order-info">
        <div class="order-num">${o.id}</div>
        <div class="order-customer">${o.customer.name} · ${o.customer.phone}</div>
        <div class="order-date">${o.date} ${o.time} · ${o.customer.address}</div>
        <div style="margin-top:6px;font-size:0.75rem;color:var(--muted);">
          ${o.items.map(i=>`${i.name} (${i.size}) ×${i.qty}`).join(' | ')}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">
        <div class="order-amount">₹${o.total.toLocaleString('en-IN')}</div>
        <select class="order-status-select" onchange="updateOrderStatus('${o.id}',this.value)">
          <option ${o.status==='Pending'?'selected':''}>Pending</option>
          <option ${o.status==='Confirmed'?'selected':''}>Confirmed</option>
          <option ${o.status==='Shipped'?'selected':''}>Shipped</option>
          <option ${o.status==='Delivered'?'selected':''}>Delivered</option>
          <option ${o.status==='Cancelled'?'selected':''}>Cancelled</option>
        </select>
      </div>
    </div>
  `).join('');
}
function updateOrderStatus(id, status) {
  const o = orders.find(x => x.id === id);
  if (o) { o.status = status; localStorage.setItem('sanjhex_orders', JSON.stringify(orders)); showToast('Status updated!'); }
}

// Settings
function loadSettings() {
  settings = JSON.parse(localStorage.getItem('sanjhex_settings') || '{}');
  adminCreds = JSON.parse(localStorage.getItem('sanjhex_creds') || '{}');
  document.getElementById('settingsUpi').value = settings.upiId || '';
  document.getElementById('settingsStoreName').value = settings.storeName || 'SANJHEX';
  document.getElementById('settingsUser').value = adminCreds.user || 'admin';
  document.getElementById('settingsPass').value = '';
}
function saveSettings() {
  settings.upiId = document.getElementById('settingsUpi').value.trim() || 'sanjhex@upi';
  settings.storeName = document.getElementById('settingsStoreName').value.trim() || 'SANJHEX';
  localStorage.setItem('sanjhex_settings', JSON.stringify(settings));
  document.getElementById('storeUpiId').textContent = settings.upiId;
  document.getElementById('statUpi').textContent = settings.upiId;
  showToast('Settings saved!');
}
function saveCredentials() {
  const u = document.getElementById('settingsUser').value.trim();
  const p = document.getElementById('settingsPass').value;
  if (!u) { showToast('Username cannot be empty!'); return; }
  adminCreds.user = u;
  if (p) adminCreds.pass = p;
  localStorage.setItem('sanjhex_creds', JSON.stringify(adminCreds));
  showToast('Credentials updated!');
}

// ========== INIT ==========
renderProducts('all');
updateCartUI();

// Duplicate marquee for seamless loop
const mt = document.getElementById('marqueeTrack');
if (mt) mt.innerHTML += mt.innerHTML;
</script>
</body>
</html>
